# pylint-odoo — UNIQUEMENT les checks spécifiques Odoo (le Python général = ruff).
# `disable=all` supprime le bruit de base (import-error sur `from odoo import ...` — odoo n'est pas
# importable hors runtime Odoo — missing-docstring, etc.) et ne laisse QUE les messages pylint-odoo
# (plage 8xxx). Version : pylint-odoo 10.0.4 — synchro avec Dockerfile + .pre-commit-config.yaml.
[MAIN]
load-plugins=pylint_odoo

[MESSAGES CONTROL]
disable=all
# Exclus volontairement (codes 8xxx) :
#   C8101 manifest-required-author  → contraint la VALEUR d'auteur (défaut "OCA") : inadapté au multi-client
#                                      (on exige la PRÉSENCE de la clé via manifest-required-keys).
#   C8111/C8114/C8115/C8117/C8118/C8119 → conventions de PUBLICATION OCA / modules "app".
#   C8112 missing-readme (README.rst forcé), R8180 consider-merging, R8181 invalid-email, W8202 use-vim-comment.
#   W8161 prefer-env-translation → force `self.env._` (reco Odoo très récente) : `_()` reste valide en 19.
enable=C8102,C8103,C8105,C8106,C8107,C8108,C8109,C8110,C8113,C8116,C8120,
    E8101,E8102,E8103,E8104,E8106,E8130,E8135,E8140,E8145,E8146,E8147,E8148,E8149,E8151,E8300,E8301,E8305,E8306,
    F8101,R8101,
    W8103,W8105,W8106,W8107,W8110,W8111,W8113,W8114,W8115,W8116,W8120,W8121,W8125,W8138,W8150,W8155,W8160,
    W8162,W8163,W8164,W8301,W8302,W8303

[ODOOLINT]
valid-odoo-versions=19.0
manifest-required-keys=name,version,author,license
